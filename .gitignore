__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Data and outputs are reproducible from configs + seeds; never commit them.
data/*
!data/README.md
experiments/*
!experiments/.gitkeep
figures/*
!figures/.gitkeep
*.tif
*.tiff
*.npy
*.npz
*.pt
*.ckpt

# Handoff bundle: built from docs/history/handoff/*.md, so the markdown is the source.
microscopy_handoff.zip

# Copyrighted third-party paper: cite it, do not redistribute it.
s41592-020-01048-5.pdf

# Second dataset: 41 GB, CC BY 4.0, downloadable from the source.
# doi 10.5281/zenodo.3895807 -- see docs/reproduction.md.
W2S_raw.zip

# Supplementary archives are built by scripts/pack_supplementary.py from the
# tree itself, so the tree is the source and the zip is an artifact.
supplementary_anonymous.zip
ieee/supplementary_ieee.zip

# Submission working directory. The run_*.sh drivers are committed because
# docs/reproduction.md refers to them; everything else here is either the
# manuscript (not code, and publishing a pre-submission draft is a decision for
# the author, not a side effect of a push), submission strategy, or logs.
# RESULTS_TCI.md is excluded too: it carries page-charge arithmetic and
# submission history alongside the numbers, and docs/reproduction.md already
# states the expected value of every result.
ieee/*
!ieee/run_*.sh

# --- Shipped derived data (must stay at the end: negations override the above)
# The per-sample feature caches every paper number is computed from, the two
# trained reconstructor checkpoints, and the two measured haze fractions.
# ~14 MB in total; they contain features, errors and cell IDs, never images.
# Checksums in experiments/SHA256SUMS; provenance in experiments/README.md.
!experiments/README.md
!experiments/SHA256SUMS
!experiments/features19/
experiments/features19/*
!experiments/features19/rl_photons_100_bg45.npz
!experiments/features19/rl_photons_15_bgprop.npz
!experiments/features19/tv_photons_100_bg45.npz
!experiments/features19/tv_photons_15_bgprop.npz
!experiments/features19/real_rl.npz
!experiments/features19/real_tv.npz
!experiments/features19/real_unet.npz
!experiments/features19/real_unrolled.npz
!experiments/features19/real_w2s_rl.npz
!experiments/features29/
!experiments/features29/*.npz
!experiments/features29_w2s/
!experiments/features29_w2s/*.npz
!experiments/gpu/
!experiments/gpu/*
!experiments/realism/
experiments/realism/*
!experiments/realism/haze_fraction.json
!experiments/realism/w2s_haze.json
